@model marvin2.Models.Chore

@{
    ViewData["Title"] = "Edit Chore";
}

<div class="view-body chore-view">
    <p><a asp-action="ManageChores">Back to Manage Chores</a></p>

    <h3>Edit Chore</h3>
    <form asp-action="EditChore" method="post" class="chore-form">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <input asp-for="Name" class="form-control chore-name-input" placeholder="Name" />
        </div>
        <div class="form-group">
            <textarea asp-for="Description" class="form-control" placeholder="Description" rows="3"></textarea>
        </div>
        <div class="form-group">
            <textarea asp-for="Notes" class="form-control" placeholder="Notes" rows="3"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
    </form>
</div>
