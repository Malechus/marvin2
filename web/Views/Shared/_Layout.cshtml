<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - M.A.R.V.I.N.</title>
    <link rel="icon" type="image/png" href="~/marvin-fingers.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav id="marvinNav" class="marvin-nav">
            <div class="marvin-nav-inner">
                <a class="marvin-nav-brand" asp-area="" asp-controller="Home" asp-action="Index">M.A.R.V.I.N.</a>
                <ul class="marvin-nav-links">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Chores">Chore Assignments</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="ManageChores">Manage Chores</a>
                    </li>
                </ul>
            </div>
            <button id="marvinNavToggle" class="marvin-nav-toggle" type="button" title="Toggle navigation" aria-expanded="true" aria-controls="marvinNav">
                <span class="marvin-nav-toggle-icon">&laquo;</span>
            </button>
        </nav>
        @if(Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") != "Production"){
            <div class="row dev-warn">
                <span class="dev-warn">DEV. DEV. DEV.</span>
            </div>
        }
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

@*
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
*@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
